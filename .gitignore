.env
.env.*
*-secret.yaml
*-secrets.yaml
secrets.yaml
*.pem
*.key
*.p12
*.jks
sa-key*.json
service-account*.json
gcp-key*.json
kubeconfig
.kube/

# Helm values overrides — likely to hold real credentials
values-local.yaml
values-secret*.yaml

